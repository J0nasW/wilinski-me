---
import Layout from '../../../layouts/Layout.astro';
import Footer from '../../../components/Footer.astro';
import { languages, useTranslations, type Lang } from '../../../i18n/index';
import { formatDate, getLocalizedPath } from '../../../i18n/utils';
import { getPosts, postSlug } from '../../../lib/content';

export function getStaticPaths() {
    return Object.keys(languages).map((lang) => ({
        params: { lang },
    }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);

const allPosts = await getPosts(lang);

// The pinned post, or else the newest one, gets the large slot at the top
const lead = allPosts.find((p) => p.data.featured) ?? allPosts[0];
const posts = allPosts.filter((p) => p !== lead);

// Group the rest by year: reads like an archive rather than a card grid
const years = [...new Set(posts.map((p) => p.data.pubDate.getFullYear()))];
---

<Layout title={`${t('blog.label')} | Jonas Wilinski`} lang={lang}>
    <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "Home", "item": `https://wilinski.me/${lang}` },
            { "@type": "ListItem", "position": 2, "name": t('blog.label') }
        ]
    })} />

    <main class="pt-32 pb-16">
        <section class="px-6 md:px-8 mb-12 md:mb-16">
            <div class="max-w-3xl mx-auto">
                <h1 class="font-display font-semibold text-5xl md:text-6xl text-neutral-900 dark:text-white mb-4">
                    {t('blog.title')}
                </h1>
                <p class="text-lg text-neutral-600 dark:text-neutral-400 max-w-2xl">
                    {t('blog.description')}
                </p>
            </div>
        </section>

        {lead && (
            <section class="px-6 md:px-8 mb-16 md:mb-20">
                <a href={getLocalizedPath(`/blog/${postSlug(lead.id)}/`, lang)} class="group block max-w-5xl mx-auto">
                    {lead.data.heroImage && (
                        <img
                            src={lead.data.heroImage}
                            alt=""
                            class="w-full aspect-[16/9] md:aspect-[21/9] rounded-lg object-cover"
                        />
                    )}
                    <div class="max-w-3xl mx-auto mt-6 md:mt-8">
                        <time datetime={lead.data.pubDate.toISOString()} class="block text-sm text-neutral-500">
                            {formatDate(lead.data.pubDate, lang)}
                            {lead.data.draft && <span class="ml-2 text-amber-600">(draft)</span>}
                        </time>
                        <h2 class="mt-2 font-display font-semibold text-3xl md:text-4xl leading-tight text-neutral-900 dark:text-white group-hover:text-accent">
                            {lead.data.title}
                        </h2>
                        <p class="mt-3 text-lg text-neutral-600 dark:text-neutral-400">
                            {lead.data.description}
                        </p>
                        <span class="inline-block mt-4 font-medium text-accent group-hover:underline underline-offset-4">
                            {t('blog.readArticle')}
                        </span>
                    </div>
                </a>
            </section>
        )}

        <section class="px-6 md:px-8">
            <div class="max-w-3xl mx-auto">
                {years.map((year) => (
                    <div class="grid md:grid-cols-[6rem_1fr] gap-2 md:gap-8 mb-10">
                        <h2 class="font-display text-2xl text-neutral-400 dark:text-neutral-500 md:pt-5">{year}</h2>
                        <ol class="divide-y divide-neutral-200 dark:divide-neutral-800">
                            {posts.filter((p) => p.data.pubDate.getFullYear() === year).map((post) => (
                                <li>
                                    <a href={getLocalizedPath(`/blog/${postSlug(post.id)}/`, lang)} class="group flex gap-5 py-5">
                                        <div class="flex-1 min-w-0">
                                            <h3 class="font-display font-semibold text-xl md:text-2xl leading-snug text-neutral-900 dark:text-white group-hover:text-accent">
                                                {post.data.title}
                                            </h3>
                                            <p class="mt-2 text-neutral-600 dark:text-neutral-400 line-clamp-2">
                                                {post.data.description}
                                            </p>
                                            <time datetime={post.data.pubDate.toISOString()} class="block mt-2 text-sm text-neutral-500">
                                                {formatDate(post.data.pubDate, lang)}
                                                {post.data.draft && <span class="ml-2 text-amber-600">(draft)</span>}
                                            </time>
                                        </div>
                                        {post.data.heroImage && (
                                            <img
                                                src={post.data.heroImage}
                                                alt=""
                                                loading="lazy"
                                                class="hidden sm:block w-28 h-20 rounded object-cover shrink-0 mt-1"
                                            />
                                        )}
                                    </a>
                                </li>
                            ))}
                        </ol>
                    </div>
                ))}

                {allPosts.length === 0 && (
                    <p class="py-20 text-neutral-500 dark:text-neutral-400">{t('blog.noPosts')}</p>
                )}
            </div>
        </section>
    </main>

    <Footer lang={lang} />
</Layout>
