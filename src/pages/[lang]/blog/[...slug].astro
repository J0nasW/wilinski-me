---
import 'katex/dist/katex.min.css';
import { type CollectionEntry, getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Footer from '../../../components/Footer.astro';
import ImageLabel from '../../../components/ui/ImageLabel.astro';
import { languages, useTranslations, type Lang } from '../../../i18n/index';
import { getPosts, postSlug } from '../../../lib/content';
import { formatDate, formatShortDate, getLocalizedPath } from '../../../i18n/utils';

export async function getStaticPaths() {
    const paths = [];
    for (const lang of Object.keys(languages) as Lang[]) {
        for (const post of await getPosts(lang)) {
            paths.push({
                params: { lang, slug: postSlug(post.id) },
                props: { post, lang },
            });
        }
    }
    return paths;
}

interface Props {
    post: CollectionEntry<'blog'>;
    lang: Lang;
}

const { post, lang } = Astro.props;
const t = useTranslations(lang);
const { Content } = await render(post);

// Two most recent other posts
const relatedPosts = (await getPosts(lang)).filter((p) => p.id !== post.id).slice(0, 2);

// Calculate reading time
const wordCount = post.body?.split(/\s+/).length || 0;
const readingTime = Math.ceil(wordCount / 200);
---

<Layout title={`${post.data.title} | Jonas Wilinski`} description={post.data.description} image={post.data.heroImage} type="article" lang={lang}>
    <!-- Article JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": post.data.title,
        "description": post.data.description,
        "image": post.data.heroImage ? new URL(post.data.heroImage, "https://wilinski.me").href : undefined,
        "datePublished": post.data.pubDate.toISOString(),
        "dateModified": (post.data.updatedDate || post.data.pubDate).toISOString(),
        "author": {
            "@type": "Person",
            "name": "Jonas Wilinski",
            "url": "https://wilinski.me"
        }
    })} />

    <!-- BreadcrumbList JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "Home", "item": `https://wilinski.me/${lang}` },
            { "@type": "ListItem", "position": 2, "name": "Blog", "item": `https://wilinski.me/${lang}/blog` },
            { "@type": "ListItem", "position": 3, "name": post.data.title }
        ]
    })} />

    <article class="px-6 md:px-8 pt-32 md:pt-40 pb-16">
        <header class="max-w-[44rem] mx-auto mb-10 md:mb-14">
            <a href={getLocalizedPath('/blog', lang)} class="text-sm text-neutral-500 hover:text-accent">
                {t('blog.backToBlog')}
            </a>

            <h1 class="mt-6 font-display font-semibold text-4xl sm:text-5xl md:text-6xl leading-[1.05] text-neutral-900 dark:text-white">
                {post.data.title}
            </h1>

            <p class="mt-6 text-sm text-neutral-500 dark:text-neutral-400">
                <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, lang)}</time>,{' '}
                {readingTime} {t('blog.minRead')}
                {post.data.draft && <span class="ml-2 text-amber-600">(draft, not published)</span>}
            </p>
        </header>

        {post.data.heroImage && (
            <figure class="relative max-w-5xl mx-auto mb-12 md:mb-16">
                <img
                    src={post.data.heroImage}
                    alt=""
                    class="w-full max-h-[28rem] object-cover rounded-md"
                />
                {post.data.heroImageAttribution && post.data.heroImageAttribution !== 'none' && (
                    <ImageLabel
                        type={post.data.heroImageAttribution}
                        label={post.data.heroImageCredit}
                        href={post.data.heroImageLink}
                        model={post.data.heroImageModel}
                        position="bottom-right"
                    />
                )}
            </figure>
        )}

        <div class="blog-content max-w-[44rem] mx-auto">
            <Content />
        </div>

        <footer class="max-w-[44rem] mx-auto mt-16 pt-8 border-t border-neutral-200 dark:border-neutral-800 flex flex-wrap items-center justify-between gap-6">
            <div class="text-sm text-neutral-500 dark:text-neutral-400">
                {post.data.tags && post.data.tags.length > 0 && (
                    <p class="mb-1">{post.data.tags.join(', ')}</p>
                )}
                {post.data.updatedDate && (
                    <p>
                        {t('blog.lastUpdated')}{' '}
                        <time datetime={post.data.updatedDate.toISOString()}>{formatDate(post.data.updatedDate, lang)}</time>
                    </p>
                )}
            </div>

            <div class="flex items-center gap-4 text-sm">
                <span class="text-neutral-500 dark:text-neutral-400">{t('blog.shareArticle')}:</span>
                <a
                    href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(Astro.url.href)}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-neutral-900 dark:text-white hover:text-accent underline underline-offset-2"
                >LinkedIn</a>
                <a
                    href={`https://bsky.app/intent/compose?text=${encodeURIComponent(`${post.data.title} ${Astro.url.href}`)}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-neutral-900 dark:text-white hover:text-accent underline underline-offset-2"
                >Bluesky</a>
                <button
                    id="copy-link-btn"
                    type="button"
                    class="text-neutral-900 dark:text-white hover:text-accent underline underline-offset-2"
                    data-url={Astro.url.href}
                    data-done={lang === 'de' ? 'Kopiert' : 'Copied'}
                >{lang === 'de' ? 'Link kopieren' : 'Copy link'}</button>
            </div>
        </footer>
    </article>

    {relatedPosts.length > 0 && (
        <section class="px-6 md:px-8 py-16 border-t border-neutral-200 dark:border-neutral-800">
            <div class="max-w-[44rem] mx-auto">
                <h2 class="font-display font-semibold text-2xl text-neutral-900 dark:text-white mb-4">
                    {t('blog.continueReading')}
                </h2>
                <ol class="divide-y divide-neutral-200 dark:divide-neutral-800">
                    {relatedPosts.map((relatedPost) => (
                        <li>
                            <a href={getLocalizedPath(`/blog/${postSlug(relatedPost.id)}/`, lang)} class="group block py-4">
                                <span class="block font-display font-semibold text-xl text-neutral-900 dark:text-white group-hover:text-accent">
                                    {relatedPost.data.title}
                                </span>
                                <time datetime={relatedPost.data.pubDate.toISOString()} class="block mt-1 text-sm text-neutral-500">
                                    {formatShortDate(relatedPost.data.pubDate, lang)}
                                </time>
                            </a>
                        </li>
                    ))}
                </ol>
            </div>
        </section>
    )}

    <Footer lang={lang} />
</Layout>

<style is:global>
    /* ==================== Base Typography ==================== */
    .blog-content {
        font-size: 1.125rem;
        line-height: 1.75;
        color: rgb(38 38 38);
    }

    .dark .blog-content {
        color: rgb(212 212 212);
    }

    /* ==================== Paragraphs ==================== */
    .blog-content p {
        margin-bottom: 1.5rem;
    }

    /* ==================== Headings ==================== */
    .blog-content h1,
    .blog-content h2,
    .blog-content h3,
    .blog-content h4,
    .blog-content h5,
    .blog-content h6 {
        font-family: var(--font-display);
        font-weight: 600;
        line-height: 1.2;
        color: rgb(23 23 23);
    }

    .dark .blog-content h1,
    .dark .blog-content h2,
    .dark .blog-content h3,
    .dark .blog-content h4,
    .dark .blog-content h5,
    .dark .blog-content h6 {
        color: rgb(250 250 250);
    }

    .blog-content h2 {
        font-size: 1.875rem;
        margin-top: 4rem;
        margin-bottom: 1.5rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid rgb(229 229 229);
    }

    @media (min-width: 768px) {
        .blog-content h2 {
            font-size: 2.25rem;
            margin-top: 5rem;
            margin-bottom: 2rem;
        }
    }

    .dark .blog-content h2 {
        border-bottom-color: rgb(64 64 64);
    }

    .blog-content h3 {
        font-size: 1.5rem;
        margin-top: 3rem;
        margin-bottom: 1.25rem;
    }

    @media (min-width: 768px) {
        .blog-content h3 {
            font-size: 1.875rem;
            margin-top: 4rem;
            margin-bottom: 1.5rem;
        }
    }

    .blog-content h4 {
        font-size: 1.25rem;
        margin-top: 2.5rem;
        margin-bottom: 1rem;
    }

    @media (min-width: 768px) {
        .blog-content h4 {
            font-size: 1.5rem;
            margin-top: 3rem;
        }
    }

    /* ==================== First Paragraph ==================== */
    .blog-content > p:first-of-type {
        font-size: 1.25rem;
        line-height: 1.7;
    }

    /* ==================== Links ==================== */
    .blog-content a {
        color: var(--color-accent);
        text-decoration: none;
        border-bottom: 1px solid rgb(35 78 122 / 0.3);
        transition: border-color 0.2s;
    }

    .blog-content a:hover {
        border-bottom-color: var(--color-accent);
    }

    /* ==================== Strong & Em ==================== */
    .blog-content strong {
        font-weight: 600;
        color: rgb(23 23 23);
    }

    .dark .blog-content strong {
        color: rgb(250 250 250);
    }

    .blog-content em {
        color: rgb(64 64 64);
    }

    .dark .blog-content em {
        color: rgb(212 212 212);
    }

    /* ==================== Inline Code ==================== */
    .blog-content code:not(pre code) {
        background: rgb(245 245 245);
        color: var(--color-accent);
        padding: 0.25rem 0.5rem;
        border-radius: 0.375rem;
        font-size: 0.9em;
        font-family: 'JetBrains Mono', 'Fira Code', monospace;
    }

    .dark .blog-content code:not(pre code) {
        background: rgb(38 38 38);
    }

    .blog-content code::before,
    .blog-content code::after {
        content: none;
    }

    /* ==================== Enhanced Blockquotes ==================== */
    .blog-content blockquote {
        position: relative;
        font-size: 1.25rem;
        border-radius: 1rem;
    }

    @media (min-width: 768px) {
        .blog-content blockquote {
            font-size: 1.375rem;
        }
    }

    .blog-content blockquote::before {
        content: '"';
        position: absolute;
        left: 1.5rem;
        top: -0.5rem;
        font-size: 5rem;
        font-family: Georgia, serif;
        color: var(--color-accent);
        opacity: 0.3;
        line-height: 1;
    }

    .blog-content blockquote p {
        position: relative;
        z-index: 1;
        margin: 0;
        line-height: 1.9;
    }

    .blog-content blockquote footer,
    .blog-content blockquote cite {
        display: block;
        margin-top: 1.5rem;
        font-size: 1rem;
        color: rgb(115 115 115);
        font-style: normal;
    }

    .dark .blog-content blockquote footer,
    .dark .blog-content blockquote cite {
        color: rgb(163 163 163);
    }

    /* ==================== Tables ==================== */
    .blog-content table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        border-radius: 1rem;
        overflow: hidden;
        border: 1px solid rgb(229 229 229);
        font-size: 1.0625rem;
    }

    @media (min-width: 768px) {
        .blog-content table {
            font-size: 1.125rem;
        }
    }

    .dark .blog-content table {
        border-color: rgb(64 64 64);
    }

    .blog-content thead {
        background: rgb(250 250 250);
    }

    .dark .blog-content thead {
        background: rgb(38 38 38);
    }

    .blog-content th {
        font-family: var(--font-display);
        font-weight: 600;
        text-align: left;
        padding: 1.25rem 1.5rem;
        border-bottom: 2px solid rgb(229 229 229);
        color: rgb(23 23 23);
    }

    .dark .blog-content th {
        border-bottom-color: rgb(64 64 64);
        color: rgb(250 250 250);
    }

    .blog-content td {
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid rgb(229 229 229);
        color: rgb(82 82 82);
        line-height: 1.7;
    }

    .dark .blog-content td {
        border-bottom-color: rgb(64 64 64);
        color: rgb(163 163 163);
    }

    .blog-content tbody tr:last-child td {
        border-bottom: none;
    }

    .blog-content tbody tr:hover {
        background: rgb(250 250 250);
    }

    .dark .blog-content tbody tr:hover {
        background: rgb(38 38 38);
    }

    /* ==================== Lists ==================== */
    .blog-content ul {
        list-style: none;
        padding-left: 0;
    }

    .blog-content ul > li {
        position: relative;
        padding-left: 2rem;
        line-height: 1.75;
    }

    .blog-content ul > li::before {
        content: '–';
        position: absolute;
        left: 0.25rem;
        color: rgb(115 115 115);
    }

    .blog-content ol {
        list-style: none;
        padding-left: 0;
        counter-reset: ol-counter;
    }

    .blog-content ol > li {
        position: relative;
        padding-left: 3rem;
        counter-increment: ol-counter;
        line-height: 1.9;
    }

    .blog-content ol > li::before {
        content: counter(ol-counter) ".";
        position: absolute;
        left: 0.25rem;
        font-variant-numeric: tabular-nums;
        color: rgb(115 115 115);
    }

    /* ==================== Code Blocks ==================== */
    .blog-content pre {
        position: relative;
        padding: 1.25rem !important;
        font-size: 0.9rem;
        line-height: 1.6;
        border-radius: 0.375rem;
    }

    .blog-content code {
        font-family: 'JetBrains Mono', 'Fira Code', monospace;
    }

    /* ==================== Math (KaTeX) ==================== */
    .blog-content .math,
    .blog-content .katex-display,
    .blog-content mjx-container {
        overflow-x: auto;
        padding: 2rem 0;
        margin: 2.5rem 0;
    }

    .blog-content .katex-display {
        padding: 1rem 0;
    }



    .blog-content .katex {
        font-size: 1.2em;
    }

    /* Inline math */
    .blog-content .math-inline,
    .blog-content mjx-container:not([display="true"]) {
        padding: 0.125rem 0.375rem;
        background: rgb(250 250 250);
        border-radius: 0.375rem;
    }

    .dark .blog-content .math-inline,
    .dark .blog-content mjx-container:not([display="true"]) {
        background: rgb(38 38 38);
    }

    /* ==================== Horizontal Rules ==================== */
    .blog-content hr {
        border: none;
        height: 1px;
        background: rgb(229 229 229);
        margin: 3rem 0;
    }

    .dark .blog-content hr {
        background: rgb(64 64 64);
    }

    /* Draft placeholders ("> **Jonas, add:** ..." / "> **Image needed:** ...") */
    .blog-content blockquote:has(> p:only-child > strong:first-child) {
        font-size: 1rem;
        border: 1px dashed rgb(217 119 6);
        background: rgb(255 251 235);
        padding: 0.75rem 1rem;
        border-radius: 0.375rem;
    }

    .blog-content blockquote:has(> p:only-child > strong:first-child)::before {
        content: none;
    }

    .dark .blog-content blockquote:has(> p:only-child > strong:first-child) {
        background: rgb(69 26 3 / 0.4);
    }

    /* ==================== Images & Figures ==================== */
    .blog-content img {
        display: block;
        width: auto;
        max-width: 100%;
        max-height: 34rem;
        margin: 2rem auto;
        border-radius: 0.375rem;
    }

    .blog-content figure {
        margin: 3.5rem 0;
    }

    .blog-content figcaption,
    .blog-content img + em {
        display: block;
        text-align: center;
        font-size: 0.9375rem;
        color: rgb(115 115 115);
        margin-top: 1.25rem;
        font-style: normal;
    }

    .dark .blog-content figcaption,
    .dark .blog-content img + em {
        color: rgb(163 163 163);
    }

    /* ==================== Definition Lists ==================== */
    .blog-content dl {
        margin: 2rem 0;
    }

    .blog-content dt {
        font-family: var(--font-display);
        font-weight: 700;
        color: rgb(23 23 23);
        margin-top: 1.5rem;
    }

    .dark .blog-content dt {
        color: rgb(250 250 250);
    }

    .blog-content dd {
        margin-left: 1.5rem;
        margin-top: 0.5rem;
        padding-left: 1rem;
        border-left: 2px solid var(--color-accent);
        color: rgb(82 82 82);
    }

    .dark .blog-content dd {
        color: rgb(163 163 163);
    }

    /* ==================== Footnotes ==================== */
    .blog-content .footnotes {
        margin-top: 4rem;
        padding-top: 2rem;
        border-top: 1px solid rgb(229 229 229);
        font-size: 0.875rem;
    }

    .dark .blog-content .footnotes {
        border-top-color: rgb(64 64 64);
    }

    .blog-content sup a {
        color: var(--color-accent);
        font-weight: 600;
        text-decoration: none;
    }

    /* ==================== Keyboard shortcuts ==================== */
    .blog-content kbd {
        display: inline-block;
        padding: 0.25rem 0.5rem;
        font-size: 0.75rem;
        font-family: 'JetBrains Mono', monospace;
        background: rgb(245 245 245);
        border: 1px solid rgb(212 212 212);
        border-radius: 0.375rem;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05), inset 0 -1px 0 rgba(0, 0, 0, 0.1);
        color: rgb(64 64 64);
    }

    .dark .blog-content kbd {
        background: rgb(38 38 38);
        border-color: rgb(64 64 64);
        color: rgb(212 212 212);
    }

    /* ==================== Abbreviations ==================== */
    .blog-content abbr[title] {
        text-decoration: underline dotted var(--color-accent);
        cursor: help;
    }

    /* ==================== Mark/Highlight ==================== */
    .blog-content mark {
        background: rgb(35 78 122 / 0.2);
        color: inherit;
        padding: 0.125rem 0.25rem;
        border-radius: 0.25rem;
    }
</style>

<script>
    function initBlogPost() {
        const copyBtn = document.getElementById('copy-link-btn');
        if (!copyBtn) return;
        const label = copyBtn.textContent;
        copyBtn.addEventListener('click', async () => {
            try {
                await navigator.clipboard.writeText(copyBtn.dataset.url || window.location.href);
                copyBtn.textContent = copyBtn.dataset.done || 'Copied';
                setTimeout(() => (copyBtn.textContent = label), 2000);
            } catch (err) {
                console.error('Failed to copy:', err);
            }
        });
    }

    initBlogPost();
    document.addEventListener('astro:page-load', initBlogPost);
</script>
