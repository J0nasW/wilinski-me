---
import Layout from '../../../layouts/Layout.astro';
import Footer from '../../../components/Footer.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import { projects } from '../../../data/projects';
import { languages, useTranslations, type Lang } from '../../../i18n/index';

export function getStaticPaths() {
    return Object.keys(languages).map((lang) => ({
        params: { lang },
    }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
---

<Layout title={`${t('projects.title')} | Jonas Wilinski`} description={t('projects.description')} lang={lang}>
    <!-- BreadcrumbList JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "Home", "item": `https://wilinski.me/${lang}` },
            { "@type": "ListItem", "position": 2, "name": t('projects.title') }
        ]
    })} />

    <main class="pt-32 pb-16">
        <section class="px-6 md:px-8 mb-8 md:mb-12">
            <div class="max-w-4xl mx-auto">
                <h1 class="font-display font-semibold text-4xl md:text-5xl lg:text-6xl text-neutral-900 dark:text-white mb-4">
                    {t('projects.title')}
                </h1>
                <p class="text-lg text-neutral-600 dark:text-neutral-400 max-w-2xl">
                    {t('projects.description')}
                </p>
            </div>
        </section>

        <section class="px-6 md:px-8">
            <div class="max-w-4xl mx-auto divide-y divide-neutral-200 dark:divide-neutral-800 border-t border-neutral-200 dark:border-neutral-800">
                {projects.map((project) => <ProjectCard project={project} lang={lang} />)}
            </div>
        </section>
    </main>

    <Footer lang={lang} />
</Layout>
