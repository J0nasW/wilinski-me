---
// Landing page for the QR code (Apple Wallet pass, slides, posters).
// Mobile first: everything someone needs right after meeting me, nothing else.
import Layout from '../../layouts/Layout.astro';
import { contact } from '../../data/contact';
import { getPublications } from '../../lib/content';
import { languages, useTranslations, type Lang } from '../../i18n/index';
import { getLocalizedPath } from '../../i18n/utils';

export function getStaticPaths() {
    return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);

const latestPaper = (await getPublications())[0];
const linkedin = contact.profiles.find((p) => p.type === 'linkedin')!.url;
const [emailUser, emailDomain] = contact.email.split('@');

const rows = [
    { label: 'LinkedIn', detail: t('card.connect'), href: linkedin, icon: 'linkedin' },
    { label: t('card.email'), detail: t('card.write'), href: '#', icon: 'email', email: true },
    { label: t('card.latestPaper'), detail: latestPaper.data.title, href: getLocalizedPath(`/publications/${latestPaper.id.replace(/\.md$/, '')}`, lang), icon: 'paper' },
    { label: t('card.research'), detail: t('card.allPapers'), href: getLocalizedPath('/publications', lang), icon: 'list' },
    { label: 'GitHub', detail: 'github.com/J0nasW', href: 'https://github.com/J0nasW', icon: 'github' },
    { label: 'ORCID', detail: '0009-0005-4672-7197', href: 'https://orcid.org/0009-0005-4672-7197', icon: 'orcid' },
];

const icons: Record<string, string> = {
    linkedin: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.064 2.064 0 1 1 0-4.128 2.064 2.064 0 0 1 0 4.128zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
    github: 'M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0 0 22 12.017C22 6.484 17.522 2 12 2z',
    orcid: 'M12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0zM7.369 4.378c.525 0 .947.431.947.947s-.422.947-.947.947a.95.95 0 0 1-.947-.947c0-.525.422-.947.947-.947zm-.722 3.038h1.444v10.041H6.647V7.416zm3.562 0h3.9c3.712 0 5.344 2.653 5.344 5.025 0 2.578-2.016 5.025-5.325 5.025h-3.919V7.416zm1.444 1.303v7.444h2.297c3.272 0 4.022-2.484 4.022-3.722 0-1.847-1.238-3.722-3.806-3.722h-2.513z',
};
// Stroke icons (24px grid)
const strokeIcons: Record<string, string> = {
    email: 'M3 7l9 6 9-6M5 19h14a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2z',
    paper: 'M9 12h6m-6 4h6m2 5H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5.586a1 1 0 0 1 .707.293l5.414 5.414a1 1 0 0 1 .293.707V19a2 2 0 0 1-2 2z',
    list: 'M4 6h16M4 12h16M4 18h10',
};
---

<Layout
    title={`Jonas Wilinski | ${t('footer.card')}`}
    description={t('card.intro')}
    lang={lang}
    bare
    noindex
>
    <div class="min-h-dvh px-5 pt-10 pb-8 max-w-md mx-auto flex flex-col">
        <header class="flex items-center gap-4">
            <img
                src="/profile.png"
                alt=""
                width="88"
                height="88"
                class="w-22 h-22 shrink-0 object-contain"
            />
            <div>
                <h1 class="font-display font-semibold text-3xl leading-tight text-neutral-900 dark:text-white">
                    {contact.firstName} {contact.lastName}
                </h1>
                <p class="text-neutral-600 dark:text-neutral-400 leading-snug mt-1">
                    {lang === 'de' ? 'Doktorand' : contact.title}<br />
                    {contact.org}
                </p>
            </div>
        </header>

        <p class="mt-6 text-neutral-700 dark:text-neutral-300 leading-relaxed">
            {t('card.intro')}
        </p>

        <a
            href="/jonas-wilinski.vcf"
            download="jonas-wilinski.vcf"
            class="mt-6 flex items-center justify-center gap-2 h-14 rounded-md bg-accent text-white text-lg font-medium hover:bg-accent-700 active:bg-accent-800 transition-colors"
        >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v12m0 0l-4-4m4 4l4-4M4 20h16" />
            </svg>
            {t('card.saveContact')}
        </a>

        <ul class="mt-6 divide-y divide-neutral-200 dark:divide-neutral-800 border-y border-neutral-200 dark:border-neutral-800">
            {rows.map((row) => (
                <li>
                    <a
                        href={row.href}
                        class:list={['flex items-center gap-4 py-4 group', row.email && 'card-email']}
                        data-user={row.email ? emailUser : undefined}
                        data-domain={row.email ? emailDomain : undefined}
                        target={row.href.startsWith('http') ? '_blank' : undefined}
                        rel={row.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                    >
                        <span class="flex items-center justify-center w-10 h-10 rounded-md bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300 shrink-0">
                            {icons[row.icon] ? (
                                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d={icons[row.icon]} /></svg>
                            ) : (
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><path d={strokeIcons[row.icon]} /></svg>
                            )}
                        </span>
                        <span class="min-w-0 flex-1">
                            <span class="block font-medium text-neutral-900 dark:text-white group-hover:text-accent">{row.label}</span>
                            <span class="block text-sm text-neutral-500 dark:text-neutral-400 truncate">{row.detail}</span>
                        </span>
                        <svg class="w-4 h-4 text-neutral-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                        </svg>
                    </a>
                </li>
            ))}
        </ul>

        <nav class="mt-auto pt-10 flex justify-between text-sm text-neutral-500">
            <a href={getLocalizedPath('/', lang)} class="hover:text-accent">{t('card.website')}</a>
            <a href={lang === 'de' ? '/en/card/' : '/de/card/'} class="hover:text-accent" hreflang={lang === 'de' ? 'en' : 'de'}>
                {lang === 'de' ? 'English' : 'Deutsch'}
            </a>
        </nav>
    </div>
</Layout>

<script>
    // Assemble the address in the browser so it isn't sitting in the HTML for scrapers
    document.querySelectorAll<HTMLAnchorElement>('.card-email').forEach((el) => {
        const { user, domain } = el.dataset;
        if (!user || !domain) return;
        el.href = `mailto:${user}@${domain}`;
        const detail = el.querySelector('.text-sm');
        if (detail) detail.textContent = `${user}@${domain}`;
    });
</script>
