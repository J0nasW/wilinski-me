---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Footer from '../../../components/Footer.astro';
import { languages, useTranslations, type Lang } from '../../../i18n/index';
import { getLocalizedPath } from '../../../i18n/utils';
import { publicationLinks, venueLine } from '../../../lib/content';

export async function getStaticPaths() {
    const publications = await getCollection('publications');
    const paths = [];

    for (const lang of Object.keys(languages)) {
        for (const publication of publications) {
            // Remove .md extension from slug
            const slug = publication.id.replace(/\.md$/, '');
            paths.push({
                params: { lang, slug },
                props: { publication, lang },
            });
        }
    }

    return paths;
}

interface Props {
    publication: CollectionEntry<'publications'>;
    lang: Lang;
}

const { publication, lang } = Astro.props;
const t = useTranslations(lang);
const { Content } = await render(publication);
const links = publicationLinks(publication.data);
---

<Layout title={`${publication.data.title} | Jonas Wilinski`} description={publication.data.tldr} lang={lang}>
    <!-- ScholarlyArticle JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "ScholarlyArticle",
        "headline": publication.data.title,
        "author": publication.data.authors.map((name: string) => ({
            "@type": "Person",
            "name": name
        })),
        "datePublished": `${publication.data.year}`,
        ...(publication.data.doi && { "sameAs": `https://doi.org/${publication.data.doi}` }),
        "publisher": {
            "@type": "Organization",
            "name": publication.data.venue
        }
    })} />

    <!-- BreadcrumbList JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "Home", "item": `https://wilinski.me/${lang}` },
            { "@type": "ListItem", "position": 2, "name": t('publications.title'), "item": `https://wilinski.me/${lang}/publications` },
            { "@type": "ListItem", "position": 3, "name": publication.data.title }
        ]
    })} />

    <main class="pt-32 pb-16">
        <!-- Back Button -->
        <div class="px-6 md:px-8 mb-8">
            <div class="max-w-3xl mx-auto">
                <a
                    href={getLocalizedPath('/publications', lang)}
                    class="inline-flex items-center gap-2 text-sm text-neutral-500 dark:text-neutral-400 hover:text-accent transition-colors"
                >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                    </svg>
                    {t('publications.backToPublications')}
                </a>
            </div>
        </div>

        <!-- Header -->
        <header class="px-6 md:px-8 mb-12">
            <div class="max-w-3xl mx-auto">
                {publication.data.logo && (
                    <img src={publication.data.logo} alt="" class="venue-logo h-10 w-auto mb-6" />
                )}

                <p class="text-neutral-500 dark:text-neutral-400 mb-4">
                    <em>{venueLine(publication.data)}</em>
                </p>

                <h1 class="font-display font-semibold text-3xl md:text-4xl lg:text-5xl text-neutral-900 dark:text-white mb-6 leading-tight">
                    {publication.data.title}
                </h1>

                <div class="text-lg text-neutral-600 dark:text-neutral-400 mb-8">
                    {publication.data.authors.join(', ')}
                </div>

                <div class="flex flex-wrap items-center gap-3">
                    {links.map((l, i) => (
                        <a
                            href={l.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class:list={[
                                'inline-flex items-center px-5 py-2.5 rounded-md font-medium transition-colors',
                                i === 0
                                    ? 'bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 hover:bg-accent dark:hover:bg-accent-300'
                                    : 'border border-neutral-300 dark:border-neutral-700 text-neutral-700 dark:text-neutral-300 hover:border-accent hover:text-accent',
                            ]}
                        >
                            {l.label === 'PDF' ? t('publications.downloadPdf') : l.label}
                        </a>
                    ))}
                </div>
            </div>
        </header>

        <!-- TL;DR & Key Points -->
        {(publication.data.tldr || (publication.data.keyPoints && publication.data.keyPoints.length > 0)) && (
            <section class="px-6 md:px-8 mb-12">
                <div class="max-w-3xl mx-auto bg-neutral-50 dark:bg-neutral-900/50 rounded-lg p-6 md:p-8 border border-neutral-100 dark:border-neutral-800">
                    {publication.data.tldr && (
                        <div class="mb-8 last:mb-0">
                            <h2 class="font-display font-semibold text-lg text-neutral-900 dark:text-white mb-3 flex items-center gap-2">
                                <span>TL;DR</span>
                            </h2>
                            <p class="text-neutral-700 dark:text-neutral-300 leading-relaxed">
                                {publication.data.tldr}
                            </p>
                        </div>
                    )}

                    {publication.data.keyPoints && publication.data.keyPoints.length > 0 && (
                        <div class="last:mb-0">
                            <h2 class="font-display font-semibold text-lg text-neutral-900 dark:text-white mb-4">
                                {t('publications.keyPoints')}
                            </h2>
                            <ul class="space-y-3">
                                {publication.data.keyPoints.map(point => (
                                    <li class="flex items-start gap-3 text-neutral-700 dark:text-neutral-300">
                                        <svg class="w-5 h-5 text-accent shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                        </svg>
                                        <span>{point}</span>
                                    </li>
                                ))}
                            </ul>
                        </div>
                    )}
                </div>
            </section>
        )}

        <!-- Abstract / Content (some entries only have metadata) -->
        {publication.body?.trim() && (
        <article class="px-6 md:px-8">
            <div class="max-w-3xl mx-auto">
                <h2 class="font-display font-semibold text-2xl text-neutral-900 dark:text-white mb-6">
                    {t('publications.abstract')}
                </h2>
                <div class="prose prose-neutral dark:prose-invert prose-lg max-w-none
                    prose-p:text-neutral-700 dark:prose-p:text-neutral-300 prose-p:leading-relaxed
                    prose-a:text-accent prose-a:no-underline hover:prose-a:underline
                ">
                    <Content />
                </div>
            </div>
        </article>
        )}

        {publication.data.bibtex && (
            <section class="px-6 md:px-8 mt-12">
                <div class="max-w-3xl mx-auto">
                    <div class="flex items-baseline justify-between mb-3">
                        <h2 class="font-display font-semibold text-2xl text-neutral-900 dark:text-white">{t('publications.cite')}</h2>
                        <button type="button" data-copy-bibtex data-copied={t('publications.copied')} class="text-sm text-accent underline underline-offset-2 hover:no-underline">
                            {t('publications.copyBibtex')}
                        </button>
                    </div>
                    <pre id="bibtex" class="text-sm leading-relaxed overflow-x-auto p-4 rounded-md bg-neutral-100 dark:bg-neutral-900 text-neutral-800 dark:text-neutral-200">{publication.data.bibtex.trim()}</pre>
                </div>
            </section>
        )}
    </main>

    <Footer lang={lang} />
</Layout>

<script>
    const button = document.querySelector<HTMLButtonElement>('[data-copy-bibtex]');
    button?.addEventListener('click', async () => {
        const text = document.getElementById('bibtex')?.textContent ?? '';
        const label = button.textContent;
        try {
            await navigator.clipboard.writeText(text);
            button.textContent = button.dataset.copied ?? 'Copied';
        } catch {
            button.textContent = 'Select the text to copy';
        }
        setTimeout(() => (button.textContent = label), 2000);
    });
</script>
