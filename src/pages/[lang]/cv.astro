---
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/Footer.astro";
import Badge from "../../components/ui/Badge.astro";
import Button from "../../components/ui/Button.astro";
import { languages, useTranslations, type Lang } from "../../i18n/index";
import {
    profile,
    skills,
    experience,
    education,
    internships,
    minorInternships,
    voluntary,
    formatPeriod,
} from "../../data/cv";

// All content comes from src/data/cv.ts, which also feeds the PDF CV.
// Logos are served locally from /public/assets/img. Avoid hotlinking services
// like unavatar.io: every visitor's IP would be sent to a third party, which
// the privacy policy does not cover.

export function getStaticPaths() {
    return Object.keys(languages).map((lang) => ({
        params: { lang },
    }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
const present = t("cv.present");

const thesisLabel = {
    dissertation: t("cv.dissertation"),
    master: t("cv.masterThesis"),
    bachelor: t("cv.bachelorThesis"),
};
---

<Layout title={`${t("cv.title")} | Jonas Wilinski`} lang={lang}>
    <!-- BreadcrumbList JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "Home", "item": `https://wilinski.me/${lang}` },
            { "@type": "ListItem", "position": 2, "name": t("cv.title") }
        ]
    })} />

    <main class="pt-32 pb-16">
        <!-- Header -->
        <section class="px-6 md:px-8 mb-12 md:mb-16">
            <div class="max-w-4xl mx-auto">
                <h1 class="font-display font-semibold text-4xl md:text-5xl lg:text-6xl text-neutral-900 dark:text-white mb-4">
                    {t("cv.title")}
                </h1>
                <p class="text-lg text-neutral-600 dark:text-neutral-400 max-w-2xl mb-3">
                    {profile.summary}
                </p>
                <p class="text-neutral-900 dark:text-white font-medium max-w-2xl mb-6">
                    {profile.availability[lang]}
                </p>
                <Button href="/jonas-wilinski-cv.pdf" variant="primary" size="md">
                    {t("cv.downloadPdf")}
                </Button>
            </div>
        </section>

        <!-- Work Experience -->
        <section class="px-6 md:px-8 mb-16">
            <div class="max-w-4xl mx-auto">
                <h2 class="font-display font-semibold text-2xl text-neutral-900 dark:text-white mb-8">
                    {t("cv.workExperience")}
                </h2>

                <div class="relative border-l-2 border-neutral-200 dark:border-neutral-700 ml-5 space-y-8">
                    {experience.map((role) => (
                        <div class="relative pl-8">
                            <div class="absolute -left-[9px] top-1 w-4 h-4 rounded-full bg-accent border-4 border-white dark:border-neutral-900"></div>
                            <div class="p-6 rounded-lg bg-neutral-50 dark:bg-neutral-800/50 border border-neutral-200 dark:border-neutral-700">
                                <div class="flex gap-4">
                                    {role.logo ? (
                                        <img src={role.logo} alt={role.org} class="w-12 h-12 object-contain shrink-0" />
                                    ) : (
                                        <div class="w-12 h-12 rounded-xl bg-accent flex items-center justify-center shrink-0">
                                            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
                                            </svg>
                                        </div>
                                    )}
                                    <div class="flex-1">
                                        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1 mb-2">
                                            <h3 class="font-display font-semibold text-xl text-neutral-900 dark:text-white">
                                                {role.title}
                                            </h3>
                                            <Badge variant="outline" size="sm">{formatPeriod(role, present)}</Badge>
                                        </div>
                                        {role.orgUrl ? (
                                            <a href={role.orgUrl} target="_blank" rel="noopener noreferrer" class="text-accent hover:underline font-medium mb-3 inline-block">
                                                {role.org}
                                            </a>
                                        ) : (
                                            <p class="text-accent font-medium mb-3">{role.org}</p>
                                        )}
                                        {role.summary && (
                                            <p class="text-neutral-600 dark:text-neutral-400">{role.summary}</p>
                                        )}
                                        {role.highlights && (
                                            <ul class="text-neutral-600 dark:text-neutral-400 text-sm space-y-1">
                                                {role.highlights.map((h) => <li>• {h}</li>)}
                                            </ul>
                                        )}
                                    </div>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- Skills -->
        <section class="px-6 md:px-8 mb-16">
            <div class="max-w-4xl mx-auto">
                <h2 class="font-display font-semibold text-2xl text-neutral-900 dark:text-white mb-8">
                    {t("cv.skills")}
                </h2>
                <dl class="grid sm:grid-cols-3 gap-6">
                    {skills.map((s) => (
                        <div>
                            <dt class="font-semibold text-neutral-900 dark:text-white mb-2">{s.group}</dt>
                            <dd class="flex flex-wrap gap-2">
                                {s.items.map((item) => <Badge variant="outline" size="sm">{item}</Badge>)}
                            </dd>
                        </div>
                    ))}
                </dl>
            </div>
        </section>

        <!-- Education -->
        <section class="px-6 md:px-8 mb-16">
            <div class="max-w-4xl mx-auto">
                <h2 class="font-display font-semibold text-2xl text-neutral-900 dark:text-white mb-8">
                    {t("cv.education")}
                </h2>

                <div class="relative border-l-2 border-neutral-200 dark:border-neutral-700 ml-5 space-y-8">
                    {education.map((d) => (
                        <div class="relative pl-8">
                            <div class="absolute -left-[9px] top-1 w-4 h-4 rounded-full bg-accent-500 border-4 border-white dark:border-neutral-900"></div>
                            <div class="p-6 rounded-lg bg-neutral-50 dark:bg-neutral-800/50 border border-neutral-200 dark:border-neutral-700">
                                <div class="flex gap-4">
                                    {d.logo && <img src={d.logo} alt={d.school} class="w-12 h-12 object-contain shrink-0" />}
                                    <div class="flex-1">
                                        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1 mb-2">
                                            <h3 class="font-display font-semibold text-xl text-neutral-900 dark:text-white">
                                                {d.degree}
                                            </h3>
                                            <Badge variant="outline" size="sm">{formatPeriod(d, present)}</Badge>
                                        </div>
                                        <p class="text-accent-600 dark:text-accent-400 font-medium">{d.school}</p>
                                        {d.note && <p class="mt-3 text-neutral-600 dark:text-neutral-400 text-sm">{d.note}</p>}
                                    </div>
                                </div>

                                {(d.thesis || d.focus) && (
                                    <div class="mt-4 p-4 rounded-xl bg-white dark:bg-neutral-800 border border-neutral-100 dark:border-neutral-700">
                                        {d.thesis && (
                                            <>
                                                <p class="font-semibold text-neutral-700 dark:text-neutral-200 mb-1">
                                                    {thesisLabel[d.thesis.kind]}{d.thesis.grade && ` (${t("cv.grade")}: ${d.thesis.grade})`}
                                                </p>
                                                <p class="text-neutral-600 dark:text-neutral-400 text-sm italic">"{d.thesis.title}"</p>
                                            </>
                                        )}
                                        {d.focus && (
                                            <>
                                                <p class="font-semibold text-neutral-700 dark:text-neutral-200 mt-4 mb-2 text-sm">
                                                    {t(`cv.${d.focus.label}`)}:
                                                </p>
                                                <div class="flex flex-wrap gap-2">
                                                    {d.focus.items.map((area) => <Badge variant="outline" size="sm">{area}</Badge>)}
                                                </div>
                                            </>
                                        )}
                                    </div>
                                )}

                                {d.concurrent && (
                                    <div class="mt-4 p-4 rounded-xl bg-accent/5 dark:bg-accent/10 border border-accent/20">
                                        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1 mb-1">
                                            <p class="font-semibold text-neutral-700 dark:text-neutral-200 text-sm">
                                                {t("cv.concurrentWork")}: {d.concurrent.title}
                                            </p>
                                            <Badge variant="outline" size="sm">{formatPeriod(d.concurrent, present)}</Badge>
                                        </div>
                                        <p class="text-neutral-600 dark:text-neutral-400 text-sm">{d.concurrent.summary}</p>
                                    </div>
                                )}
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- Internships -->
        <section class="px-6 md:px-8 mb-16">
            <div class="max-w-4xl mx-auto">
                <h2 class="font-display font-semibold text-2xl text-neutral-900 dark:text-white mb-8">
                    {t("cv.internships")}
                </h2>

                <div class="grid md:grid-cols-2 gap-4 mb-6">
                    {internships.map((i) => (
                        <div class="p-6 rounded-lg bg-neutral-50 dark:bg-neutral-800/50 border border-neutral-200 dark:border-neutral-700">
                            <div class="flex gap-4">
                                {i.logo && <img src={i.logo} alt={i.org} class="w-10 h-10 object-contain shrink-0" />}
                                <div class="flex-1">
                                    <div class="flex items-center justify-between gap-2 mb-2">
                                        <h3 class="font-display font-semibold text-lg text-neutral-900 dark:text-white">{i.org}</h3>
                                        <Badge variant="outline" size="sm">{formatPeriod(i, present)}</Badge>
                                    </div>
                                    <p class="text-accent font-medium text-sm mb-2">{i.title}</p>
                                    {i.highlights && (
                                        <ul class="text-sm text-neutral-600 dark:text-neutral-400 space-y-1">
                                            {i.highlights.map((h) => <li>• {h}</li>)}
                                        </ul>
                                    )}
                                </div>
                            </div>
                        </div>
                    ))}
                </div>

                <div class="grid md:grid-cols-3 gap-4">
                    {minorInternships.map((i) => (
                        <div class="p-4 rounded-xl bg-white dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700">
                            <h3 class="font-display font-semibold text-neutral-900 dark:text-white mb-1">{i.org}</h3>
                            <p class="text-sm text-neutral-500 dark:text-neutral-400 mb-2">{i.location}</p>
                            <p class="text-sm text-neutral-600 dark:text-neutral-400">{i.summary}</p>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- Voluntary -->
        <section class="px-6 md:px-8 mb-16">
            <div class="max-w-4xl mx-auto">
                <h2 class="font-display font-semibold text-2xl text-neutral-900 dark:text-white mb-8">
                    {t("cv.voluntary")}
                </h2>

                {voluntary.map((role) => (
                    <div class="p-6 rounded-lg bg-neutral-50 dark:bg-neutral-800/50 border border-neutral-200 dark:border-neutral-700">
                        <div class="flex gap-4">
                            {role.logo && <img src={role.logo} alt={role.org} class="w-12 h-12 object-contain shrink-0" />}
                            <div class="flex-1">
                                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1 mb-2">
                                    <h3 class="font-display font-semibold text-xl text-neutral-900 dark:text-white">{role.title}</h3>
                                    <Badge variant="outline" size="sm">{formatPeriod(role, present)}</Badge>
                                </div>
                                {role.orgUrl ? (
                                    <a href={role.orgUrl} target="_blank" rel="noopener noreferrer" class="text-accent hover:underline font-medium mb-3 inline-block">{role.org}</a>
                                ) : (
                                    <p class="text-accent font-medium mb-3">{role.org}</p>
                                )}
                                {role.summary && <p class="text-neutral-600 dark:text-neutral-400">{role.summary}</p>}
                            </div>
                        </div>
                    </div>
                ))}
            </div>
        </section>

        <!-- Links -->
        <section class="px-6 md:px-8">
            <div class="max-w-4xl mx-auto">
                <h2 class="font-display font-semibold text-2xl text-neutral-900 dark:text-white mb-8">
                    {t("cv.references")}
                </h2>

                <div class="grid md:grid-cols-2 gap-4">
                    <a
                        href="http://boostnow.de/"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="group p-6 rounded-lg bg-neutral-50 dark:bg-neutral-800/50 border border-neutral-200 dark:border-neutral-700 hover:border-accent/50 transition-colors"
                    >
                        <h3 class="font-display font-semibold text-lg text-neutral-900 dark:text-white mb-2 group-hover:text-accent transition-colors">
                            BoostNow
                        </h3>
                        <p class="text-sm text-neutral-600 dark:text-neutral-400">
                            Former project / reference homepage.
                        </p>
                    </a>

                    <a
                        href="https://github.com/J0nasW"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="group p-6 rounded-lg bg-neutral-50 dark:bg-neutral-800/50 border border-neutral-200 dark:border-neutral-700 hover:border-accent/50 transition-colors"
                    >
                        <h3 class="font-display font-semibold text-lg text-neutral-900 dark:text-white mb-2 group-hover:text-accent transition-colors">
                            GitHub (J0nasW)
                        </h3>
                        <p class="text-sm text-neutral-600 dark:text-neutral-400">
                            Check out my code and repositories.
                        </p>
                    </a>
                </div>
            </div>
        </section>
    </main>

    <Footer lang={lang} />
</Layout>
