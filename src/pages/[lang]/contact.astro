---
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/Footer.astro";
import { socialLinks } from "../../data/socialLinks";
import { languages, useTranslations, type Lang } from "../../i18n/index";
import { getLocalizedPath } from "../../i18n/utils";

export function getStaticPaths() {
    return Object.keys(languages).map((lang) => ({
        params: { lang },
    }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);

const handles: Record<string, string> = {
    linkedin: "jonas-wilinski",
    github: "J0nasW",
    x: "@Jonas_H_W",
    bluesky: "@jonashw.bsky.social",
    orcid: "0009-0005-4672-7197",
    huggingface: "J0nasW",
};

const reasons = [t("contact.reason1"), t("contact.reason2"), t("contact.reason3")];
---

<Layout title={`${t("contact.label")} | Jonas Wilinski`} lang={lang}>
    <!-- BreadcrumbList JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "Home", "item": `https://wilinski.me/${lang}` },
            { "@type": "ListItem", "position": 2, "name": t("contact.label") }
        ]
    })} />

    <main class="pt-32 pb-16 px-6 md:px-8">
        <div class="max-w-5xl mx-auto">
            <h1 class="font-display font-semibold text-5xl md:text-6xl text-neutral-900 dark:text-white mb-4">
                {t("contact.title")}
            </h1>
            <p class="text-lg text-neutral-600 dark:text-neutral-400 max-w-xl mb-12 md:mb-16">
                {t("contact.description")}
            </p>

            <div class="grid md:grid-cols-[1fr_20rem] gap-12 md:gap-20">
                <div>
                    <h2 class="text-sm font-medium text-neutral-500 dark:text-neutral-400 mb-2">{t("contact.email")}</h2>
                    <a
                        href="#"
                        class="protected-email font-display font-semibold text-3xl md:text-5xl text-accent break-all underline decoration-1 underline-offset-[6px] hover:no-underline"
                        data-user="jonas"
                        data-domain="wilinski.me"
                    >
                        <span class="email-placeholder">{t("contact.clickToReveal")}</span>
                    </a>
                    <p class="mt-3 text-neutral-600 dark:text-neutral-400">
                        {t("contact.emailDescription")}
                    </p>

                    <h2 class="mt-12 font-display font-semibold text-2xl text-neutral-900 dark:text-white mb-4">
                        {t("contact.reasonsTitle")}
                    </h2>
                    <ul class="space-y-3 text-neutral-700 dark:text-neutral-300 max-w-prose">
                        {reasons.map((r) => (
                            <li class="pl-5 relative before:content-['–'] before:absolute before:left-0 before:text-neutral-400">{r}</li>
                        ))}
                    </ul>

                    <p class="mt-6 text-neutral-700 dark:text-neutral-300 max-w-prose">
                        {t("contact.quickLook")}{" "}
                        <a href="/jonas-wilinski-cv.pdf" class="text-accent underline underline-offset-2 hover:no-underline">{t("cv.downloadPdf")}</a>,{" "}
                        <a href={getLocalizedPath("/projects", lang)} class="text-accent underline underline-offset-2 hover:no-underline">{t("nav.projects")}</a>,{" "}
                        <a href={getLocalizedPath("/cv", lang)} class="text-accent underline underline-offset-2 hover:no-underline">{t("nav.experience")}</a>.
                    </p>

                    <h2 class="mt-12 font-display font-semibold text-2xl text-neutral-900 dark:text-white mb-3">
                        {t("contact.saveTitle")}
                    </h2>
                    <p class="text-neutral-700 dark:text-neutral-300 max-w-prose">
                        {t("contact.saveText")}{" "}
                        <a href="/jonas-wilinski.vcf" download class="text-accent underline underline-offset-2 hover:no-underline">{t("card.saveContact")} (.vcf)</a>
                        {lang === "de" ? " oder die " : " or open the "}
                        <a href={getLocalizedPath("/card", lang)} class="text-accent underline underline-offset-2 hover:no-underline">{t("footer.card")}</a>
                    </p>
                </div>

                <aside>
                    <h2 class="text-sm font-medium text-neutral-500 dark:text-neutral-400 mb-2">{t("contact.findMeOn")}</h2>
                    <dl class="divide-y divide-neutral-200 dark:divide-neutral-800 border-y border-neutral-200 dark:border-neutral-800">
                        {socialLinks.map((link) => (
                            <div>
                                <a
                                    href={link.href}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="group flex items-baseline justify-between gap-4 py-3"
                                >
                                    <dt class="text-neutral-900 dark:text-white group-hover:text-accent">{link.label}</dt>
                                    <dd class="text-sm text-neutral-500 dark:text-neutral-400 truncate">{handles[link.id]}</dd>
                                </a>
                            </div>
                        ))}
                    </dl>

                    <h2 class="mt-10 text-sm font-medium text-neutral-500 dark:text-neutral-400 mb-2">{t("contact.location")}</h2>
                    <p class="text-neutral-900 dark:text-white">{t("contact.locationText")}</p>
                </aside>
            </div>
        </div>
    </main>

    <Footer lang={lang} />
</Layout>

<script>
    // Email protection - decode and display emails only via JavaScript
    function decodeEmail(user: string, domain: string): string {
        return `${user}@${domain}`;
    }

    function initEmailProtection() {
        // Handle email links
        document.querySelectorAll(".protected-email").forEach((el) => {
            const element = el as HTMLAnchorElement;
            const user = element.dataset.user;
            const domain = element.dataset.domain;
            if (user && domain) {
                const email = decodeEmail(user, domain);
                element.href = `mailto:${email}`;
                const placeholder = element.querySelector(".email-placeholder");
                if (placeholder) {
                    placeholder.textContent = email;
                }
            }
        });

        // Handle email buttons
        document.querySelectorAll(".protected-email-btn").forEach((el) => {
            const element = el as HTMLButtonElement;
            const user = element.dataset.user;
            const domain = element.dataset.domain;
            if (user && domain) {
                element.addEventListener("click", () => {
                    const email = decodeEmail(user, domain);
                    window.location.href = `mailto:${email}`;
                });
            }
        });
    }

    // Run on initial load
    initEmailProtection();

    // Run on Astro page transitions
    document.addEventListener("astro:page-load", initEmailProtection);
</script>
