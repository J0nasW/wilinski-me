---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import { languages, useTranslations, type Lang } from '../../i18n/index';

export function getStaticPaths() {
    return Object.keys(languages).map((lang) => ({
        params: { lang },
    }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
---

<Layout title={`${t('privacy.title')} | Jonas Wilinski`} lang={lang}>
    <!-- BreadcrumbList JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "Home", "item": `https://wilinski.me/${lang}` },
            { "@type": "ListItem", "position": 2, "name": t('privacy.title') }
        ]
    })} />

    <div class="pt-24 pb-16">
        <!-- Header -->
        <section class="px-6 md:px-8 mb-12">
            <div class="max-w-3xl mx-auto">
                <div data-reveal>
                    <span class="text-xs font-bold uppercase tracking-wider text-accent mb-2 block">
                        {t('privacy.label')}
                    </span>
                    <h1 class="font-display font-bold text-4xl md:text-5xl text-neutral-900 dark:text-white mb-4">
                        {t('privacy.title')}
                    </h1>
                    <p class="text-neutral-600 dark:text-neutral-400">
                        {t('privacy.intro')}
                    </p>
                </div>
            </div>
        </section>

        <!-- Content -->
        <section class="px-6 md:px-8">
            <div class="max-w-3xl mx-auto space-y-8">
                <!-- Data Controller -->
                <div class="p-8 md:p-10 rounded-3xl bg-neutral-50 dark:bg-neutral-800/50 border border-neutral-200 dark:border-neutral-700" data-reveal>
                    <div class="prose prose-neutral dark:prose-invert max-w-none
                        prose-headings:font-display prose-headings:font-bold
                        prose-h3:text-lg prose-h3:mt-0 prose-h3:mb-4
                        prose-p:text-neutral-600 dark:prose-p:text-neutral-400
                    ">
                        <h3>{t('privacy.controller')}</h3>
                        <p>{t('privacy.controllerText')}</p>
                        <p>
                            Jonas Wilinski<br />
                            Kirchstr. 6<br />
                            21218 Seevetal (bei Hamburg)<br />
                            E-Mail: jonas@wilinski.me
                        </p>
                    </div>
                </div>

                <!-- Hosting -->
                <div class="p-8 md:p-10 rounded-3xl bg-neutral-50 dark:bg-neutral-800/50 border border-neutral-200 dark:border-neutral-700" data-reveal>
                    <div class="prose prose-neutral dark:prose-invert max-w-none
                        prose-headings:font-display prose-headings:font-bold
                        prose-h3:text-lg prose-h3:mt-0 prose-h3:mb-4
                        prose-p:text-neutral-600 dark:prose-p:text-neutral-400
                    ">
                        <h3>{t('privacy.hosting')}</h3>
                        <p>{t('privacy.hostingText')}</p>
                    </div>
                </div>

                <!-- Analytics -->
                <div class="p-8 md:p-10 rounded-3xl bg-neutral-50 dark:bg-neutral-800/50 border border-neutral-200 dark:border-neutral-700" data-reveal>
                    <div class="prose prose-neutral dark:prose-invert max-w-none
                        prose-headings:font-display prose-headings:font-bold
                        prose-h3:text-lg prose-h3:mt-0 prose-h3:mb-4
                        prose-p:text-neutral-600 dark:prose-p:text-neutral-400
                    ">
                        <h3>{t('privacy.analytics')}</h3>
                        <p>{t('privacy.analyticsText')}</p>
                    </div>
                </div>

                <!-- Local Storage -->
                <div class="p-8 md:p-10 rounded-3xl bg-neutral-50 dark:bg-neutral-800/50 border border-neutral-200 dark:border-neutral-700" data-reveal>
                    <div class="prose prose-neutral dark:prose-invert max-w-none
                        prose-headings:font-display prose-headings:font-bold
                        prose-h3:text-lg prose-h3:mt-0 prose-h3:mb-4
                        prose-p:text-neutral-600 dark:prose-p:text-neutral-400
                    ">
                        <h3>{t('privacy.localStorage')}</h3>
                        <p>{t('privacy.localStorageText')}</p>
                    </div>
                </div>

                <!-- Fonts -->
                <div class="p-8 md:p-10 rounded-3xl bg-neutral-50 dark:bg-neutral-800/50 border border-neutral-200 dark:border-neutral-700" data-reveal>
                    <div class="prose prose-neutral dark:prose-invert max-w-none
                        prose-headings:font-display prose-headings:font-bold
                        prose-h3:text-lg prose-h3:mt-0 prose-h3:mb-4
                        prose-p:text-neutral-600 dark:prose-p:text-neutral-400
                    ">
                        <h3>{t('privacy.fonts')}</h3>
                        <p>{t('privacy.fontsText')}</p>
                    </div>
                </div>

                <!-- External Links -->
                <div class="p-8 md:p-10 rounded-3xl bg-neutral-50 dark:bg-neutral-800/50 border border-neutral-200 dark:border-neutral-700" data-reveal>
                    <div class="prose prose-neutral dark:prose-invert max-w-none
                        prose-headings:font-display prose-headings:font-bold
                        prose-h3:text-lg prose-h3:mt-0 prose-h3:mb-4
                        prose-p:text-neutral-600 dark:prose-p:text-neutral-400
                    ">
                        <h3>{t('privacy.externalLinks')}</h3>
                        <p>{t('privacy.externalLinksText')}</p>
                    </div>
                </div>

                <!-- Contact -->
                <div class="p-8 md:p-10 rounded-3xl bg-neutral-50 dark:bg-neutral-800/50 border border-neutral-200 dark:border-neutral-700" data-reveal>
                    <div class="prose prose-neutral dark:prose-invert max-w-none
                        prose-headings:font-display prose-headings:font-bold
                        prose-h3:text-lg prose-h3:mt-0 prose-h3:mb-4
                        prose-p:text-neutral-600 dark:prose-p:text-neutral-400
                    ">
                        <h3>{t('privacy.contact')}</h3>
                        <p>{t('privacy.contactText')}</p>
                    </div>
                </div>

                <!-- Your Rights -->
                <div class="p-8 md:p-10 rounded-3xl bg-neutral-50 dark:bg-neutral-800/50 border border-neutral-200 dark:border-neutral-700" data-reveal>
                    <div class="prose prose-neutral dark:prose-invert max-w-none
                        prose-headings:font-display prose-headings:font-bold
                        prose-h3:text-lg prose-h3:mt-0 prose-h3:mb-4
                        prose-p:text-neutral-600 dark:prose-p:text-neutral-400
                    ">
                        <h3>{t('privacy.rights')}</h3>
                        <p>{t('privacy.rightsText')}</p>
                        <ul>
                            <li>{t('privacy.rightAccess')}</li>
                            <li>{t('privacy.rightRectification')}</li>
                            <li>{t('privacy.rightErasure')}</li>
                            <li>{t('privacy.rightRestriction')}</li>
                            <li>{t('privacy.rightPortability')}</li>
                            <li>{t('privacy.rightObjection')}</li>
                        </ul>
                    </div>
                </div>

                <!-- Right to Lodge a Complaint -->
                <div class="p-8 md:p-10 rounded-3xl bg-neutral-50 dark:bg-neutral-800/50 border border-neutral-200 dark:border-neutral-700" data-reveal>
                    <div class="prose prose-neutral dark:prose-invert max-w-none
                        prose-headings:font-display prose-headings:font-bold
                        prose-h3:text-lg prose-h3:mt-0 prose-h3:mb-4
                        prose-p:text-neutral-600 dark:prose-p:text-neutral-400
                    ">
                        <h3>{t('privacy.complaint')}</h3>
                        <p>{t('privacy.complaintText')}</p>
                        <p>{t('privacy.supervisory')}</p>
                    </div>
                </div>

                <!-- Changes -->
                <div class="p-8 md:p-10 rounded-3xl bg-neutral-50 dark:bg-neutral-800/50 border border-neutral-200 dark:border-neutral-700" data-reveal>
                    <div class="prose prose-neutral dark:prose-invert max-w-none
                        prose-headings:font-display prose-headings:font-bold
                        prose-h3:text-lg prose-h3:mt-0 prose-h3:mb-4
                        prose-p:text-neutral-600 dark:prose-p:text-neutral-400
                    ">
                        <h3>{t('privacy.changes')}</h3>
                        <p>{t('privacy.changesText')}</p>
                        <p class="text-sm text-neutral-500 dark:text-neutral-500 italic">
                            {t('privacy.lastUpdated')}: 04.03.2026
                        </p>
                    </div>
                </div>
            </div>
        </section>
    </div>

    <Footer lang={lang} />
</Layout>
