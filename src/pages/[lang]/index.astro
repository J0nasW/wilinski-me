---
import Layout from "../../layouts/Layout.astro";
import HeroSection from "../../components/sections/HeroSection.astro";
import CTASection from "../../components/sections/CTASection.astro";
import Footer from "../../components/Footer.astro";
import { languages, useTranslations, type Lang } from "../../i18n/index";
import { formatShortDate, getLocalizedPath } from "../../i18n/utils";
import ProjectCard from "../../components/ProjectCard.astro";
import { getPosts, getPublications, postSlug, venueLine } from "../../lib/content";
import { profile } from "../../data/cv";
import { projects } from "../../data/projects";

export function getStaticPaths() {
    return Object.keys(languages).map((lang) => ({
        params: { lang },
    }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);

const publications = (await getPublications()).slice(0, 4);
const posts = (await getPosts(lang)).slice(0, 4);
const featured = projects.filter((p) => p.featured);
---

<Layout title="Jonas Wilinski | ML Engineer & Researcher" lang={lang}>
    <!-- WebSite JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "Jonas Wilinski",
        "url": "https://wilinski.me",
        "description": "Personal website of Jonas Wilinski, ML engineer and PhD candidate working on NLP models and data infrastructure.",
        "author": {
            "@type": "Person",
            "name": "Jonas Wilinski",
            "url": "https://wilinski.me"
        }
    })} />

    <HeroSection
        name="Jonas Wilinski"
        title={t("hero.title")}
        subtitle={t("hero.subtitle")}
        availability={profile.availability[lang]}
        lang={lang}
    />

    <!-- Projects -->
    <section class="px-6 md:px-8 py-16 md:py-20 border-t border-neutral-200 dark:border-neutral-800">
        <div class="max-w-5xl mx-auto">
            <div class="flex items-baseline justify-between mb-2">
                <h2 class="font-display font-semibold text-2xl md:text-3xl text-neutral-900 dark:text-white">
                    {t("home.projects")}
                </h2>
                <a href={getLocalizedPath("/projects", lang)} class="text-sm text-accent hover:underline">
                    {t("home.allProjects")}
                </a>
            </div>
            <div class="divide-y divide-neutral-200 dark:divide-neutral-800">
                {featured.map((project) => <ProjectCard project={project} lang={lang} />)}
            </div>
        </div>
    </section>

    <!-- Recent papers and writing -->
    <section class="px-6 md:px-8 py-16 md:py-20 border-t border-neutral-200 dark:border-neutral-800">
        <div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-12 md:gap-16">
            <div>
                <div class="flex items-baseline justify-between mb-6">
                    <h2 class="font-display font-semibold text-2xl md:text-3xl text-neutral-900 dark:text-white">
                        {t("home.recentPapers")}
                    </h2>
                    <a href={getLocalizedPath("/publications", lang)} class="text-sm text-accent hover:underline">
                        {t("home.allPapers")}
                    </a>
                </div>
                <ol class="divide-y divide-neutral-200 dark:divide-neutral-800">
                    {publications.map((pub) => (
                        <li class="py-4">
                            <a
                                href={getLocalizedPath(`/publications/${pub.id.replace(/\.md$/, "")}`, lang)}
                                class="group block"
                            >
                                <span class="block font-medium text-neutral-900 dark:text-white group-hover:text-accent leading-snug">
                                    {pub.data.title}
                                </span>
                                <span class="block mt-1 text-sm text-neutral-500 dark:text-neutral-400">
                                    {venueLine(pub.data)}
                                </span>
                            </a>
                        </li>
                    ))}
                </ol>
            </div>

            <div>
                <div class="flex items-baseline justify-between mb-6">
                    <h2 class="font-display font-semibold text-2xl md:text-3xl text-neutral-900 dark:text-white">
                        {t("home.recentPosts")}
                    </h2>
                    <a href={getLocalizedPath("/blog", lang)} class="text-sm text-accent hover:underline">
                        {t("home.allPosts")}
                    </a>
                </div>
                <ol class="divide-y divide-neutral-200 dark:divide-neutral-800">
                    {posts.map((post) => (
                        <li class="py-4">
                            <a href={getLocalizedPath(`/blog/${postSlug(post.id)}/`, lang)} class="group block">
                                <span class="block font-medium text-neutral-900 dark:text-white group-hover:text-accent leading-snug">
                                    {post.data.title}
                                </span>
                                <time
                                    datetime={post.data.pubDate.toISOString()}
                                    class="block mt-1 text-sm text-neutral-500 dark:text-neutral-400"
                                >
                                    {formatShortDate(post.data.pubDate, lang)}
                                </time>
                            </a>
                        </li>
                    ))}
                </ol>
            </div>
        </div>
    </section>

    <!-- About -->
    <section class="px-6 md:px-8 py-16 md:py-20 border-t border-neutral-200 dark:border-neutral-800">
        <div class="max-w-5xl mx-auto grid md:grid-cols-[12rem_1fr] gap-4 md:gap-16">
            <h2 class="font-display font-semibold text-2xl md:text-3xl text-neutral-900 dark:text-white">
                {t("about.title")}
            </h2>
            <p class="text-lg text-neutral-700 dark:text-neutral-300 leading-relaxed max-w-prose">
                {t("about.textIntro")} <a href={getLocalizedPath('/cv', lang)} class="text-accent underline underline-offset-2 hover:no-underline">{t("about.linkCV")}</a>{t("about.textMid")} <a href={getLocalizedPath('/publications', lang)} class="text-accent underline underline-offset-2 hover:no-underline">{t("about.linkPublications")}</a>{t("about.textEnd")} {t("about.hobbies")} <a href={getLocalizedPath('/hobbies', lang)} class="text-accent underline underline-offset-2 hover:no-underline">{t("about.linkHobbies")}</a>.
            </p>
        </div>
    </section>

    <CTASection lang={lang} />

    <Footer lang={lang} />
</Layout>
