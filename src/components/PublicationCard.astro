---
import type { CollectionEntry } from 'astro:content';
import { defaultLang, type Lang } from '../i18n/index';
import { getLocalizedPath } from '../i18n/utils';
import { publicationLinks, venueLine } from '../lib/content';

interface Props {
    publication: CollectionEntry<'publications'>;
    lang?: Lang;
}

const { publication, lang = defaultLang } = Astro.props;
const { data } = publication;
const links = publicationLinks(data);

// Highlight my own name in author lists, the way CVs and lab pages do
const isMe = (name: string) => /^Jonas (Helmut )?Wilinski$/.test(name);
---

<article class="py-6 sm:grid sm:grid-cols-[7.5rem_1fr] sm:gap-6">
    <div class="mb-3 sm:mb-0 sm:pt-1">
        {data.logo && (
            <img
                src={data.logo}
                alt=""
                class="venue-logo h-7 sm:h-auto sm:max-h-10 w-auto sm:max-w-full object-contain object-left"
                
            />
        )}
    </div>

    <div>
        <h3 class="font-display font-semibold text-xl md:text-2xl leading-snug text-neutral-900 dark:text-white">
            <a href={getLocalizedPath(`/publications/${publication.id.replace(/\.md$/, '')}`, lang)} class="hover:text-accent">
                {data.title}
            </a>
        </h3>

        <p class="mt-2 text-neutral-600 dark:text-neutral-400">
            {data.authors.map((name, i) => (
                <>
                    <span class:list={[isMe(name) && 'text-neutral-900 dark:text-white font-medium']}>{name}</span>{i < data.authors.length - 1 && ', '}
                </>
            ))}
        </p>

        <p class="mt-1 text-sm text-neutral-500 dark:text-neutral-400">
            <em>{venueLine(data)}</em>
        </p>

        {links.length > 0 && (
            <p class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-sm">
                {links.map((l) => (
                    <a href={l.url} target="_blank" rel="noopener noreferrer" class="text-accent underline underline-offset-2 hover:no-underline">{l.label}</a>
                ))}
            </p>
        )}
    </div>
</article>
